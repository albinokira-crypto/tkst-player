{
  "buildCommand": "echo Vercel Ready",
  "outputDirectory": "public",
  "cleanUrls": true,
  "functions": {
    "api/*.js": {
      "includeFiles": "{updates/**,updates/_expo/**,updates/_expo/static/**,updates/_expo/static/js/**,updates/_expo/static/js/android/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ]
}
